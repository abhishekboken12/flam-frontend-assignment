# Copy to frontend/.env if you need it (this exact folder). Not
# required for local dev — leave unset and Vite's dev-server proxy
# (vite.config.js) handles routing '/api/...' to the local server.
#
# Only set this when the frontend is deployed separately from the
# server (different origin) — point it at the server's full URL:
# VITE_API_BASE_URL=https://your-server-domain.example.com
VITE_API_BASE_URL=
