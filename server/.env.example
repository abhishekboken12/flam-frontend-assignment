# Copy this file to server/.env (this exact folder). server/index.js
# loads it via dotenv/config, which reads .env relative to wherever
# the process is started from — see server/package.json's scripts,
# which cd into this folder before running node. Never commit .env.

# Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
# llama-3.3-70b-versatile was decommissioned by Groq on 2026-09-21.
# If this one ever 404s too, check https://console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b
PORT=8787

# The frontend's dev-server origin. In production, set this to your
# deployed frontend's URL (comma-separate if there's more than one).
CORS_ORIGIN=http://localhost:5173
